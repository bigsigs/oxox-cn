    }

    @keyframes reveal { from { opacity: 0; } to { opacity: 1; } }
    @keyframes rise { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: none; } }
    @keyframes spin { to { transform: rotate(360deg); } }
    @keyframes dotOrbitClockwise {
      0%, 100% { transform: translate(0, 0) scale(1); }
      12% { transform: translate(var(--dot-travel), 0) scale(.86); }
      34% { transform: translate(0, var(--dot-travel)) scale(1); }
      56% { transform: translate(calc(var(--dot-travel) * -1), 0) scale(.86); }
      78% { transform: translate(0, calc(var(--dot-travel) * -1)) scale(1); }
      92% { transform: translate(calc(var(--dot-travel) * .45), 0) scale(.92); }
    }
    @keyframes dotOrbitCounter {
