---
import Wordmark from "../components/Wordmark.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import tools from "../data/tools.js";
import periods from "../../public/data/yueqing-export-ranking/periods.json";
import latestRanking from "../../public/data/yueqing-export-ranking/2026-ytd-07.json";

const topRecords = latestRanking.records.slice(0, 3);
const latestReport = (await getCollection("articles", ({ data }) => !data.draft))
  .sort((a: CollectionEntry<"articles">, b: CollectionEntry<"articles">) => b.data.periodEnd.valueOf() - a.data.periodEnd.valueOf())[0];
const liveTools = tools.filter((tool) => tool.status === "live" && tool.category !== "data");
const formatNumber = (value: number) => new Intl.NumberFormat("zh-CN").format(value);
const capabilities = [
  ["01", "累计周期切换", "在已收录的累计周期之间切换，查看企业当期排名和出口额区间。"],
  ["02", "企业跨期档案", "使用稳定企业编号连接同一主体，集中查看历次排名记录。"],
  ["03", "排名变化对比", "比较较上期和去年同期名次，快速识别企业排名变化。"],
];
const siteSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://oxox.cn/#organization",
      name: "OXOX 乐清出口数据",
      url: "https://oxox.cn/",
    },
    {
      "@type": "WebSite",
      "@id": "https://oxox.cn/#website",
      name: "OXOX 乐清出口数据",
      url: "https://oxox.cn/",
      inLanguage: "zh-CN",
      publisher: { "@id": "https://oxox.cn/#organization" },
      potentialAction: {
        "@type": "SearchAction",
        target: "https://oxox.cn/yueqing-export-ranking/?q={search_term_string}",
        "query-input": "required name=search_term_string",
      },
    },
  ],
};
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="查询乐清企业累计出口排名、出口额区间和历史名次变化，覆盖多个累计周期。">
  <meta name="theme-color" content="#f2f0e8">
  <link rel="canonical" href="https://oxox.cn/">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <title>乐清出口企业排名查询｜乐清外贸出口数据｜OXOX</title>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(siteSchema).replace(/</g, "\\u003c")}></script>
  <style is:global>
    :root {
      --paper: #f2f0e8;
      --paper-light: #faf9f4;
      --ink: #18201d;
      --muted: #68716c;
      --green: #0b634b;
      --green-dark: #064636;
      --orange: #ff5c35;
      --yellow: #f5d451;
      --line: rgba(24, 32, 29, .16);
      --shadow: 0 24px 70px rgba(24, 32, 29, .1);
      --serif: "Iowan Old Style", "Baskerville", "Songti SC", "STSong", serif;
      --sans: "Avenir Next", "PingFang SC", "Hiragino Sans GB", sans-serif;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; background: var(--paper); }
    body {
      margin: 0;
      min-width: 320px;
      color: var(--ink);
      font-family: var(--sans);
      background:
        linear-gradient(90deg, transparent 49.9%, rgba(24,32,29,.035) 50%, transparent 50.1%),
        radial-gradient(circle at 12% 0%, rgba(255,255,255,.96), transparent 31rem),
        var(--paper);
      background-size: 56px 100%, auto, auto;
    }

    a { color: inherit; text-decoration: none; }
    button, input { color: inherit; font: inherit; }
    button { cursor: pointer; }
    svg { display: block; }

    .noise {
      position: fixed;
      inset: 0;
      z-index: 20;
      opacity: .03;
      pointer-events: none;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.8'/%3E%3C/svg%3E");
    }

    .shell {
      width: min(1240px, calc(100% - 48px));
      margin: 0 auto;
    }

    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .site-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 92px;
      border-bottom: 1px solid var(--line);
      animation: reveal .7s ease both;
    }

    .brand {
      display: inline-flex;
      align-items: center;
      gap: 14px;
    }

    .wordmark {
      --dot-travel: 10px;
      width: 126px;
      height: auto;
      overflow: visible;
    }

    .wordmark .logo-dot,
    .footer-mark .logo-dot {
      transform-box: fill-box;
      transform-origin: center;
      will-change: transform;
    }

    .brand:hover .dot-warm,
    .brand:focus-visible .dot-warm,
    .footer-mark:hover .dot-warm {
      animation: dotOrbitClockwise .9s cubic-bezier(.45, 0, .2, 1);
    }

    .brand:hover .dot-green,
    .brand:focus-visible .dot-green,
    .footer-mark:hover .dot-green {
      animation: dotOrbitCounter .9s .06s cubic-bezier(.45, 0, .2, 1);
    }

    .brand-label {
      padding-left: 14px;
      border-left: 1px solid var(--line);
      color: var(--muted);
      font-size: 12px;
      font-weight: 650;
      letter-spacing: .12em;
    }

    .header-nav {
      display: flex;
      align-items: center;
      gap: 32px;
      font-size: 13px;
      font-weight: 650;
    }

    .header-nav > a:not(.nav-cta) {
      position: relative;
      padding: 9px 0;
    }

    .header-nav > a:not(.nav-cta)::after {
      content: "";
      position: absolute;
      right: 0;
      bottom: 3px;
      left: 0;
      height: 2px;
      background: var(--orange);
      transform: scaleX(0);
      transform-origin: right;
      transition: transform .24s ease;
    }

    .header-nav > a:hover::after,
    .header-nav > a:focus-visible::after {
      transform: scaleX(1);
      transform-origin: left;
    }

    .nav-cta {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 11px 16px;
      border: 1px solid var(--ink);
      border-radius: 100px;
      background: var(--paper-light);
      transition: transform .2s ease, box-shadow .2s ease;
    }

    .nav-cta:hover,
    .nav-cta:focus-visible {
      transform: translateY(-2px);
      box-shadow: 4px 4px 0 var(--yellow);
    }

    .hero {
      position: relative;
      display: grid;
      grid-template-columns: minmax(0, 1.25fr) minmax(300px, .75fr);
      gap: clamp(42px, 6vw, 82px);
      min-height: 650px;
      padding: 76px 0 68px;
      border-bottom: 1px solid var(--line);
      overflow: clip;
    }

    .hero-copy {
      position: relative;
      z-index: 5;
      align-self: center;
    }

    .eyebrow {
      display: flex;
      align-items: center;
      gap: 12px;
      margin: 0 0 28px;
      color: var(--green);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: .18em;
      text-transform: uppercase;
      animation: rise .7s .12s ease both;
    }

    .eyebrow::before {
      content: "";
      width: 28px;
      height: 7px;
      border-radius: 100px;
      background: var(--orange);
    }

    h1 {
      max-width: 830px;
      margin: 0;
      font-family: var(--serif);
      font-size: clamp(58px, 7.2vw, 104px);
      font-weight: 400;
      letter-spacing: -.07em;
      line-height: .9;
      animation: rise .8s .18s ease both;
    }

    h1 .accent {
      position: relative;
      display: inline-block;
      color: var(--green);
      font-style: italic;
    }

    h1 .accent::after {
      content: "";
      position: absolute;
      right: -.08em;
      bottom: -.09em;
      left: .04em;
      height: .085em;
      border-radius: 50%;
      background: var(--orange);
      transform: rotate(-2deg);
    }

    .hero-intro {
      max-width: 640px;
      margin: 32px 0 0;
      color: var(--muted);
      font-size: 15px;
      line-height: 1.85;
      animation: rise .8s .26s ease both;
    }

    .hero-intro strong { color: var(--ink); }

    .company-search {
      position: relative;
      display: grid;
      grid-template-columns: 1fr auto;
      max-width: 760px;
      margin-top: 34px;
      border: 2px solid var(--green);
      background: white;
      box-shadow: 8px 8px 0 rgba(245, 212, 81, .95);
      animation: rise .8s .34s ease both;
      transition: box-shadow .2s ease, transform .2s ease;
    }

    .company-search:focus-within {
      z-index: 10;
      box-shadow: 11px 11px 0 var(--yellow);
      transform: translate(-2px, -2px);
    }

    .search-field {
      position: relative;
      min-width: 0;
    }

    .search-icon {
      position: absolute;
      top: 50%;
      left: 21px;
      width: 23px;
      transform: translateY(-50%);
      pointer-events: none;
    }

    .company-search input {
      width: 100%;
      min-width: 0;
      min-height: 72px;
      padding: 0 24px 0 58px;
      border: 0;
      outline: 0;
      background: transparent;
      font-size: 15px;
    }

    .company-search input::placeholder { color: #8a918d; }

    .company-search button {
      min-width: 142px;
      padding: 0 27px;
      border: 0;
      color: white;
      background: var(--orange);
      font-weight: 800;
      transition: color .2s ease, background .2s ease;
    }

    .company-suggestions {
      position: fixed;
      z-index: 100;
      max-height: 344px;
      margin: 0;
      padding: 0;
      overflow-y: auto;
      border: 2px solid var(--green);
      border-top: 0;
      background: var(--paper-light);
      box-shadow: 8px 8px 0 rgba(24, 32, 29, .12);
      list-style: none;
    }

    .company-suggestions[hidden] { display: none; }

    .company-suggestion {
      border-top: 1px solid var(--line);
    }

    .company-suggestion:first-child { border-top: 0; }

    .company-suggestion a {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 18px;
      min-height: 56px;
      padding: 12px 18px;
      transition: color .16s ease, background .16s ease;
    }

    .company-suggestion strong {
      overflow: hidden;
      font-size: 13px;
      font-weight: 700;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .company-suggestion span {
      color: var(--green);
      font-family: var(--serif);
      font-size: 15px;
      font-weight: 700;
      white-space: nowrap;
    }

    .company-suggestion[aria-selected="true"] a,
    .company-suggestion a:hover {
      color: white;
      background: var(--green);
    }

    .company-suggestion[aria-selected="true"] span,
    .company-suggestion a:hover span {
      color: var(--yellow);
    }

    .company-search button:hover,
    .company-search button:focus-visible {
      color: var(--yellow);
      background: var(--green);
    }

    .full-ranking-cta {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 24px;
      align-items: center;
      max-width: 760px;
      min-height: 92px;
      margin-top: 18px;
      padding: 17px 22px;
      border: 1px solid var(--green-dark);
      color: white;
      background: var(--green);
      box-shadow: 8px 8px 0 var(--yellow);
      animation: rise .8s .39s ease both;
      transition: color .2s ease, background .2s ease, box-shadow .2s ease, transform .2s ease;
    }

    .full-ranking-cta small {
      display: block;
      margin-bottom: 7px;
      color: rgba(255,255,255,.7);
      font-size: 9px;
      font-weight: 850;
      letter-spacing: .15em;
    }

    .full-ranking-cta strong {
      display: block;
      font-family: var(--serif);
      font-size: clamp(24px, 2.2vw, 32px);
      font-weight: 400;
      letter-spacing: -.035em;
      line-height: 1.08;
    }

    .full-ranking-cta > span:last-child {
      font-family: var(--serif);
      font-size: 34px;
      transition: transform .2s ease;
    }

    .full-ranking-cta:hover,
    .full-ranking-cta:focus-visible {
      color: var(--ink);
      background: var(--yellow);
      box-shadow: 10px 10px 0 var(--orange);
      outline: 0;
      transform: translate(-2px, -2px);
    }

    .full-ranking-cta:hover small,
    .full-ranking-cta:focus-visible small { color: rgba(24,32,29,.62); }
    .full-ranking-cta:hover > span:last-child,
    .full-ranking-cta:focus-visible > span:last-child { transform: translateX(7px); }

    .search-hint {
      display: flex;
      align-items: center;
      gap: 9px;
      margin: 17px 0 0;
      color: var(--muted);
      font-size: 11px;
      animation: rise .8s .4s ease both;
    }

    .search-hint::before {
      content: "";
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--green);
      box-shadow: 0 0 0 4px rgba(11, 99, 75, .1);
    }

    .hero-art {
      position: relative;
      z-index: 3;
      display: grid;
      place-items: center;
      min-height: 480px;
      animation: rise .9s .3s ease both;
    }

    .orbit {
      position: absolute;
      width: min(31vw, 390px);
      aspect-ratio: 1;
      border: 1px solid var(--line);
      border-radius: 50%;
      animation: spin 30s linear infinite;
    }

    .orbit::before,
    .orbit::after {
      content: "";
      position: absolute;
      z-index: 4;
      border-radius: 50%;
    }

    .orbit::before {
      top: 8%;
      left: 7%;
      width: 18px;
      height: 18px;
      background: var(--orange);
      box-shadow: 0 0 0 8px var(--paper);
    }

    .orbit::after {
      right: 3%;
      bottom: 17%;
      width: 14px;
      height: 14px;
      background: var(--green);
      box-shadow: 0 0 0 8px var(--paper);
    }

    .period-card {
      position: relative;
      z-index: 5;
      width: min(100%, 350px);
      padding: 30px;
      border: 1px solid var(--ink);
      background: var(--yellow);
      box-shadow: 12px 12px 0 var(--green);
      transform: rotate(1.5deg);
      transition: transform .35s cubic-bezier(.2,.8,.2,1);
    }

    .period-card:hover { transform: rotate(-1deg) translateY(-4px); }

    .period-card > small {
      display: block;
      margin-bottom: 25px;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: .18em;
    }

    .period-card strong {
      display: block;
      padding-bottom: 22px;
      border-bottom: 1px solid rgba(24,32,29,.28);
      font-family: var(--serif);
      font-size: clamp(36px, 3.3vw, 46px);
      font-weight: 400;
      letter-spacing: -.05em;
      line-height: 1;
      white-space: normal;
      text-wrap: balance;
    }

    .period-stat {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 15px;
      align-items: center;
      padding: 16px 0;
      border-bottom: 1px solid rgba(24,32,29,.18);
      font-size: 12px;
    }

    .period-stat:last-of-type { border-bottom: 0; }

    .period-stat b {
      min-width: 0;
      font-family: var(--serif);
      font-size: 23px;
      font-weight: 400;
      text-align: right;
      overflow-wrap: anywhere;
    }

    .period-link {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      min-height: 58px;
      margin-top: 17px;
      padding: 14px 17px;
      border: 1px solid white;
      color: white;
      background: var(--orange);
      box-shadow: 6px 6px 0 rgba(24,32,29,.13);
      font-size: 13px;
      font-weight: 800;
      line-height: 1.35;
      transition: color .2s ease, background .2s ease, box-shadow .2s ease, transform .2s ease;
    }

    .period-link:hover,
    .period-link:focus-visible {
      color: var(--yellow);
      background: var(--green);
      box-shadow: 8px 8px 0 rgba(24,32,29,.18);
      outline: 0;
      transform: translate(-2px, -2px);
    }

    .data-strip {
      display: grid;
      grid-template-columns: auto repeat(3, 1fr) auto;
      border-bottom: 1px solid var(--line);
    }

    .data-strip > * {
      display: flex;
      align-items: center;
      min-height: 72px;
      padding: 0 23px;
      border-left: 1px solid var(--line);
    }

    .data-strip > *:last-child { border-right: 1px solid var(--line); }

    .data-label {
      gap: 10px;
      color: var(--green);
      font-size: 10px;
      font-weight: 850;
      letter-spacing: .12em;
    }

    .data-label i {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: var(--orange);
    }

    .data-value {
      justify-content: space-between;
      gap: 14px;
      color: var(--muted);
      font-size: 11px;
    }

    .data-value b {
      color: var(--ink);
      font-family: var(--serif);
      font-size: 22px;
      font-weight: 400;
      white-space: nowrap;
    }

    .data-strip-link {
      gap: 8px;
      color: var(--green);
      font-size: 11px;
      font-weight: 800;
      white-space: nowrap;
    }

    .section {
      padding: 94px 0 105px;
      border-bottom: 1px solid var(--line);
    }

    .section-head {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 35px;
      margin-bottom: 40px;
    }

    .section-kicker {
      margin: 0 0 11px;
      color: var(--orange);
      font-size: 10px;
      font-weight: 850;
      letter-spacing: .18em;
      text-transform: uppercase;
    }

    h2 {
      margin: 0;
      font-family: var(--serif);
      font-size: clamp(42px, 5vw, 67px);
      font-weight: 400;
      letter-spacing: -.055em;
      line-height: 1;
    }

    .text-link {
      display: inline-flex;
      align-items: center;
      gap: 11px;
      padding-bottom: 4px;
      border-bottom: 1px solid currentColor;
      color: var(--green);
      font-size: 12px;
      font-weight: 800;
    }

    .text-link span { transition: transform .2s ease; }
    .text-link:hover span { transform: translateX(4px); }

    .ranking-preview {
      display: grid;
      grid-template-columns: minmax(0, 1.45fr) minmax(260px, .55fr);
      border: 1px solid var(--ink);
      background: var(--paper-light);
    }

    .ranking-list { min-width: 0; }

    .ranking-head,
    .ranking-row {
      display: grid;
      grid-template-columns: 84px minmax(240px, 1fr) 205px 42px;
      align-items: center;
    }

    .ranking-head {
      min-height: 52px;
      color: rgba(255,255,255,.64);
      background: var(--ink);
      font-size: 9px;
      font-weight: 750;
      letter-spacing: .12em;
    }

    .ranking-head span,
    .ranking-row > * { padding: 0 20px; }

    .ranking-row {
      min-height: 96px;
      border-bottom: 1px solid var(--line);
      transition: color .18s ease, background .18s ease;
    }

    .ranking-row:last-child { border-bottom: 0; }

    .ranking-row:hover,
    .ranking-row:focus-visible {
      color: white;
      background: var(--green);
      outline: 0;
    }

    .ranking-row > b {
      font-family: var(--serif);
      font-size: 33px;
      font-weight: 400;
    }

    .ranking-company {
      min-width: 0;
      font-size: 14px;
      font-weight: 750;
    }

    .ranking-company small {
      display: block;
      margin-top: 7px;
      font-size: 9px;
      font-weight: 600;
      letter-spacing: .11em;
      opacity: .55;
    }

    .ranking-row em {
      justify-self: start;
      padding: 7px 10px;
      border: 1px solid currentColor;
      border-radius: 100px;
      font-size: 10px;
      font-style: normal;
      font-weight: 750;
      white-space: nowrap;
    }

    .ranking-arrow {
      display: grid;
      place-items: center;
      width: 35px;
      height: 35px;
      padding: 0 !important;
      border: 1px solid currentColor;
      border-radius: 50%;
    }

    .ranking-note {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 34px;
      border-left: 1px solid var(--ink);
      color: white;
      background: var(--green);
    }

    .ranking-note small {
      font-size: 9px;
      font-weight: 800;
      letter-spacing: .16em;
      opacity: .62;
    }

    .ranking-note strong {
      display: block;
      margin: 28px 0 18px;
      font-family: var(--serif);
      font-size: 31px;
      font-weight: 400;
      letter-spacing: -.04em;
      line-height: 1.15;
    }

    .ranking-note p {
      margin: 0;
      color: rgba(255,255,255,.68);
      font-size: 12px;
      line-height: 1.8;
    }

    .ranking-note .note-mark {
      align-self: end;
      width: 82px;
      height: 82px;
      margin-top: 40px;
      border: 1px solid rgba(255,255,255,.5);
      border-radius: 50%;
      background:
        radial-gradient(circle, var(--orange) 0 8px, transparent 9px),
        radial-gradient(circle, transparent 0 25px, var(--yellow) 26px 29px, transparent 30px);
    }

    .report-section {
      padding: 94px 0 105px;
      border-bottom: 1px solid var(--line);
    }

    .report-feature {
      display: grid;
      grid-template-columns: minmax(0, 1.25fr) minmax(300px, .75fr);
      min-height: 390px;
      border: 1px solid var(--ink);
      color: white;
      background: var(--ink);
      transition: transform .22s ease, box-shadow .22s ease;
    }

