  <script>
    import { buildCompanySearchIndex, suggestCompanies } from "../lib/ranking-core.js";

    type SuggestionRecord = {
      rank: number;
      company_id: string;
      company_name: string;
    };

    const input = document.querySelector<HTMLInputElement>("#companyQuery");
    const suggestionsBox = document.querySelector<HTMLUListElement>("#companySuggestions");
    const searchForm = document.querySelector<HTMLFormElement>("#companySearchForm");
    if (!input || !suggestionsBox || !searchForm) throw new Error("Company autocomplete controls are missing");
    document.body.append(suggestionsBox);
    const latestDataUrl = "/data/yueqing-export-ranking/2026-ytd-07.json";
    let latestRecords: SuggestionRecord[] | null = null;
    let searchIndex: Map<string, string> | null = null;
    let loadingPromise: Promise<SuggestionRecord[]> | null = null;
    let activeIndex = -1;
    let focusTimer: number | undefined;

    const isMobileSearch = () => window.matchMedia("(max-width: 760px)").matches;

    const focusSearchArea = () => {
      if (!isMobileSearch()) return;
      document.body.classList.add("search-focused");
      window.clearTimeout(focusTimer);
      focusTimer = window.setTimeout(() => {
        searchForm.scrollIntoView({ behavior: "smooth", block: "start" });
        window.setTimeout(positionSuggestions, 220);
      }, 120);
    };

    const leaveSearchFocus = () => {
      window.clearTimeout(focusTimer);
      document.body.classList.remove("search-focused");
    };

    const closeSuggestions = () => {
      suggestionsBox.hidden = true;
      suggestionsBox.replaceChildren();
      input.setAttribute("aria-expanded", "false");
      input.removeAttribute("aria-activedescendant");
      activeIndex = -1;
    };

    const positionSuggestions = () => {
      if (suggestionsBox.hidden) return;
      const field = input.closest<HTMLElement>(".search-field");
      if (!field) return;
      const rect = field.getBoundingClientRect();
      const viewportBottom = window.visualViewport
        ? window.visualViewport.offsetTop + window.visualViewport.height
        : window.innerHeight;
      const availableHeight = Math.max(112, viewportBottom - rect.bottom - 16);
      suggestionsBox.style.top = `${rect.bottom}px`;
      suggestionsBox.style.left = `${rect.left}px`;
      suggestionsBox.style.width = `${rect.width}px`;
      suggestionsBox.style.maxHeight = `${Math.min(344, availableHeight)}px`;
    };

    const loadLatestRecords = async () => {
      if (latestRecords) return latestRecords;
      if (!loadingPromise) {
        input.setAttribute("aria-busy", "true");
        loadingPromise = fetch(latestDataUrl)
          .then((response) => {
            if (!response.ok) throw new Error(`Latest ranking request failed: ${response.status}`);
            return response.json();
          })
          .then((data) => {
            latestRecords = Array.isArray(data.records) ? data.records : [];
            searchIndex = buildCompanySearchIndex(latestRecords);
            return latestRecords;
          })
          .catch(() => {
            latestRecords = [];
            searchIndex = new Map();
            return latestRecords;
          })
          .finally(() => input.removeAttribute("aria-busy"));
      }
      return loadingPromise;
    };

    const setActiveSuggestion = (nextIndex: number) => {
      const options = [...suggestionsBox.querySelectorAll<HTMLElement>('[role="option"]')];
      if (!options.length) return;
      activeIndex = (nextIndex + options.length) % options.length;
      options.forEach((option, index) => {
        option.setAttribute("aria-selected", String(index === activeIndex));
      });
      const active = options[activeIndex];
      input.setAttribute("aria-activedescendant", active.id);
      active.scrollIntoView({ block: "nearest" });
    };

    const renderSuggestions = async () => {
      const query = input.value.trim();
      if (!query) {
        closeSuggestions();
        return;
      }

      const records = await loadLatestRecords();
      if (query !== input.value.trim()) return;
      const matches = suggestCompanies(records, query, {
        searchIndex: searchIndex || new Map(),
        limit: 6,
      });
      if (!matches.length) {
        closeSuggestions();
        return;
      }

      const fragment = document.createDocumentFragment();
      matches.forEach((record: SuggestionRecord, index: number) => {
        const option = document.createElement("li");
        const link = document.createElement("a");
        const name = document.createElement("strong");
        const rank = document.createElement("span");
        option.className = "company-suggestion";
        option.id = `company-suggestion-${index}`;
        option.setAttribute("role", "option");
        option.setAttribute("aria-selected", "false");
        link.href = `/yueqing-export-ranking/?q=${encodeURIComponent(record.company_name)}`;
        link.tabIndex = -1;
        name.textContent = record.company_name;
        rank.textContent = `第 ${record.rank} 名`;
        link.append(name, rank);
        option.append(link);
        fragment.append(option);
      });
      suggestionsBox.replaceChildren(fragment);
      suggestionsBox.hidden = false;
      positionSuggestions();
      input.setAttribute("aria-expanded", "true");
      activeIndex = -1;
    };

    input.addEventListener("input", renderSuggestions);
    input.addEventListener("focus", () => {
      focusSearchArea();
      if (input.value.trim()) renderSuggestions();
    });
    input.addEventListener("blur", () => {
      window.setTimeout(() => {
        if (document.activeElement !== input && !suggestionsBox.matches(":hover")) {
          leaveSearchFocus();
        }
      }, 120);
    });
    input.addEventListener("keydown", (event: KeyboardEvent) => {
      if (suggestionsBox.hidden) return;
      const options = [...suggestionsBox.querySelectorAll<HTMLElement>('[role="option"]')];
      if (event.key === "ArrowDown") {
        event.preventDefault();
        setActiveSuggestion(activeIndex + 1);
      } else if (event.key === "ArrowUp") {
        event.preventDefault();
        setActiveSuggestion(activeIndex - 1);
      } else if (event.key === "Escape") {
        closeSuggestions();
        input.blur();
        leaveSearchFocus();
      } else if (event.key === "Enter" && activeIndex >= 0) {
        event.preventDefault();
        options[activeIndex].querySelector<HTMLAnchorElement>("a")?.click();
      }
    });
    document.addEventListener("pointerdown", (event: PointerEvent) => {
      if (
        !(event.target instanceof Element)
        || (
          !event.target.closest("#companySearchForm")
          && !suggestionsBox.contains(event.target)
        )
      ) {
        closeSuggestions();
        leaveSearchFocus();
      }
    });
    window.addEventListener("resize", positionSuggestions);
    window.visualViewport?.addEventListener("resize", positionSuggestions);
    window.visualViewport?.addEventListener("scroll", positionSuggestions);
    document.addEventListener("scroll", positionSuggestions, { capture: true, passive: true });
  </script>
</body>
</html>
