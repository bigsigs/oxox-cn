---
import Wordmark from "../components/Wordmark.astro";
import tools from "../data/tools.js";
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="OXOX 外贸小工具，为外贸人提供简单、直接、好用的图片、文本与计算工具。">
  <meta name="theme-color" content="#f2f0e8">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='16' fill='%2318201d'/%3E%3Ccircle cx='32' cy='32' r='18' fill='none' stroke='%23f5d451' stroke-width='7'/%3E%3Ccircle cx='32' cy='32' r='5' fill='%23ff5c35'/%3E%3C/svg%3E">
  <title>OXOX 外贸小工具｜让外贸工作少一点重复</title>
  <style is:global>
    :root {
      --paper: #f2f0e8;
      --paper-light: #faf9f4;
      --ink: #18201d;
      --muted: #68716c;
      --green: #0b634b;
      --green-dark: #064636;
      --orange: #ff5c35;
      --yellow: #f5d451;
      --line: rgba(24, 32, 29, .16);
      --shadow: 0 24px 70px rgba(24, 32, 29, .09);
      --serif: "Iowan Old Style", "Baskerville", "Songti SC", "STSong", serif;
      --sans: "Avenir Next", "PingFang SC", "Hiragino Sans GB", sans-serif;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; background: var(--paper); }
    body {
      margin: 0;
      min-width: 320px;
      color: var(--ink);
      font-family: var(--sans);
      background:
        linear-gradient(90deg, transparent 49.9%, rgba(24, 32, 29, .035) 50%, transparent 50.1%),
        radial-gradient(circle at 12% 0%, rgba(255,255,255,.95), transparent 30rem),
        var(--paper);
      background-size: 56px 100%, auto, auto;
    }

    a { color: inherit; text-decoration: none; }
    button, input { font: inherit; }
    button { color: inherit; }
    svg { display: block; }

    .noise {
      position: fixed;
      inset: 0;
      z-index: 20;
      opacity: .03;
      pointer-events: none;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.8'/%3E%3C/svg%3E");
    }

    .shell {
      width: min(1240px, calc(100% - 48px));
      margin: 0 auto;
    }

    .site-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 92px;
      border-bottom: 1px solid var(--line);
      animation: reveal .7s ease both;
    }

    .brand {
      display: inline-flex;
      align-items: center;
      gap: 14px;
    }

    .wordmark {
      --dot-travel: 10px;
      width: 126px;
      height: auto;
      overflow: visible;
    }

    .wordmark .logo-dot,
    .footer-mark .logo-dot {
      transform-box: fill-box;
      transform-origin: center;
      will-change: transform;
    }

    .brand:hover .dot-warm,
    .brand:focus-visible .dot-warm,
    .footer-mark:hover .dot-warm {
      animation: dotOrbitClockwise .9s cubic-bezier(.45, 0, .2, 1);
    }

    .brand:hover .dot-green,
    .brand:focus-visible .dot-green,
    .footer-mark:hover .dot-green {
      animation: dotOrbitCounter .9s .06s cubic-bezier(.45, 0, .2, 1);
    }
    .brand-label {
      padding-left: 14px;
      border-left: 1px solid var(--line);
      color: var(--muted);
      font-size: 12px;
      font-weight: 650;
      letter-spacing: .12em;
    }

    .header-nav {
      display: flex;
      align-items: center;
      gap: 34px;
      font-size: 13px;
      font-weight: 650;
    }

    .header-nav > a:not(.nav-cta) {
      position: relative;
      padding: 9px 0;
    }

    .header-nav > a:not(.nav-cta)::after {
      content: "";
      position: absolute;
      right: 0;
      bottom: 3px;
      left: 0;
      height: 2px;
      background: var(--orange);
      transform: scaleX(0);
      transform-origin: right;
      transition: transform .24s ease;
    }

    .header-nav > a:hover::after { transform: scaleX(1); transform-origin: left; }

    .nav-cta {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 11px 16px;
      border: 1px solid var(--ink);
      border-radius: 100px;
      background: var(--paper-light);
      transition: transform .2s ease, box-shadow .2s ease;
    }

    .nav-cta:hover { transform: translateY(-2px); box-shadow: 4px 4px 0 var(--yellow); }

    .hero {
      position: relative;
      display: grid;
      grid-template-columns: minmax(0, 1.35fr) minmax(300px, .65fr);
      min-height: 610px;
      padding: 76px 0 66px;
      border-bottom: 1px solid var(--line);
      overflow: hidden;
    }

    .hero-copy { position: relative; z-index: 2; }

    .eyebrow {
      display: flex;
      align-items: center;
      gap: 12px;
      margin: 0 0 30px;
      color: var(--green);
      font-size: 12px;
      font-weight: 750;
      letter-spacing: .18em;
      text-transform: uppercase;
      animation: rise .7s .12s ease both;
    }

    .eyebrow::before {
      content: "";
      width: 28px;
      height: 7px;
      border-radius: 100px;
      background: var(--orange);
    }

    h1 {
      max-width: 820px;
      margin: 0;
      font-family: var(--serif);
      font-size: clamp(58px, 7.5vw, 112px);
      font-weight: 400;
      letter-spacing: -.075em;
      line-height: .88;
      animation: rise .8s .18s ease both;
    }

    h1 .accent {
      position: relative;
      display: inline-block;
      color: var(--green);
      font-style: italic;
    }

    h1 .accent::after {
      content: "";
      position: absolute;
      right: -.1em;
      bottom: -.08em;
      left: .05em;
      height: .09em;
      border-radius: 50%;
      background: var(--orange);
      transform: rotate(-2deg);
    }

    .hero-intro {
      display: grid;
      grid-template-columns: 80px minmax(0, 460px);
      gap: 22px;
      align-items: start;
      margin-top: 44px;
      animation: rise .8s .28s ease both;
    }

    .hero-no {
      padding-top: 5px;
      border-top: 1px solid var(--ink);
      font: 700 11px/1.4 var(--sans);
      letter-spacing: .12em;
    }

    .hero-intro p {
      margin: 0;
      color: var(--muted);
      font-size: 16px;
      line-height: 1.9;
    }

    .hero-intro strong { color: var(--ink); }

    .hero-art {
      position: relative;
      display: grid;
      place-items: center;
      min-height: 400px;
      animation: rise .9s .35s ease both;
    }

    .orbit {
      position: absolute;
      width: min(31vw, 390px);
      aspect-ratio: 1;
      border: 1px solid var(--line);
      border-radius: 50%;
      animation: spin 28s linear infinite;
    }

    .orbit::before, .orbit::after {
      content: "";
      position: absolute;
      border-radius: 50%;
    }

    .orbit::before {
      top: 9%;
      left: 5%;
      width: 18px;
      height: 18px;
      background: var(--orange);
      box-shadow: 0 0 0 8px var(--paper);
    }

    .orbit::after {
      right: 3%;
      bottom: 17%;
      width: 14px;
      height: 14px;
      background: var(--green);
      box-shadow: 0 0 0 8px var(--paper);
    }

    .stamp {
      position: relative;
      z-index: 2;
      width: 220px;
      aspect-ratio: 1;
      padding: 17px;
      border: 1px solid var(--ink);
      border-radius: 50%;
      background: var(--yellow);
      transform: rotate(7deg);
      box-shadow: 14px 18px 0 var(--green);
      transition: transform .4s cubic-bezier(.2,.8,.2,1);
    }

    .stamp:hover { transform: rotate(-2deg) scale(1.03); }

    .stamp-inner {
      display: grid;
      place-items: center;
      width: 100%;
      height: 100%;
      border: 1px dashed var(--ink);
      border-radius: 50%;
      text-align: center;
    }

    .stamp-inner b {
      display: block;
      font-family: var(--serif);
      font-size: 54px;
      font-weight: 400;
      letter-spacing: -.08em;
      line-height: .8;
    }

    .stamp-inner span {
      display: block;
      margin-top: 15px;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: .2em;
    }

    .tools-section { padding: 96px 0 110px; }

    .section-head {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 30px;
      align-items: end;
      margin-bottom: 44px;
    }

    .section-kicker {
      margin: 0 0 12px;
      color: var(--orange);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: .18em;
      text-transform: uppercase;
    }

    h2 {
      margin: 0;
      font-family: var(--serif);
      font-size: clamp(42px, 5vw, 68px);
      font-weight: 400;
      letter-spacing: -.055em;
      line-height: 1;
    }

    .tool-filter {
      display: flex;
      gap: 5px;
      padding: 5px;
      border: 1px solid var(--line);
      border-radius: 100px;
      background: rgba(250, 249, 244, .7);
    }

    .filter-btn {
      padding: 9px 16px;
      border: 0;
      border-radius: 100px;
      background: transparent;
      cursor: pointer;
      font-size: 12px;
      font-weight: 700;
      transition: background .2s ease, color .2s ease;
    }

    .filter-btn.active { color: white; background: var(--green); }

    .tools-grid {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      gap: 18px;
    }

    .tool-card {
      position: relative;
      grid-column: span 4;
      min-height: 330px;
      padding: 26px;
      border: 1px solid var(--line);
      border-radius: 2px;
      background: rgba(250, 249, 244, .72);
      overflow: hidden;
      transition: transform .28s ease, box-shadow .28s ease, background .28s ease;
      animation: cardIn .5s ease both;
    }

    .tool-card.featured {
      grid-column: span 8;
      color: white;
      background: var(--green);
      border-color: var(--green);
    }

    .tool-card.live:hover {
      transform: translateY(-7px);
      box-shadow: var(--shadow);
    }

    .tool-card.featured:hover { background: var(--green-dark); }

    .card-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .tool-index {
      font: 700 11px/1 var(--sans);
      letter-spacing: .16em;
      opacity: .66;
    }

    .tool-status {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 7px 10px;
      border: 1px solid currentColor;
      border-radius: 100px;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: .08em;
    }

    .tool-status::before {
      content: "";
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: currentColor;
    }

    .live .tool-status::before { animation: pulse 1.8s ease infinite; }
    .planned { color: var(--muted); }
    .planned .tool-status { opacity: .65; }

    .tool-icon {
      display: grid;
      place-items: center;
      width: 58px;
      height: 58px;
      margin: 58px 0 24px;
      border: 1px solid currentColor;
      border-radius: 50%;
      color: var(--green);
      background: var(--yellow);
    }

    .tool-card.featured .tool-icon {
      position: absolute;
      top: 74px;
      right: 32px;
      width: 132px;
      height: 132px;
      margin: 0;
      color: var(--ink);
      transform: rotate(-7deg);
    }

    .tool-icon svg { width: 28px; height: 28px; }
    .tool-card.featured .tool-icon svg { width: 54px; height: 54px; }

    .tool-card h3 {
      max-width: 72%;
      margin: 0 0 13px;
      font-family: var(--serif);
      font-size: 29px;
      font-weight: 400;
      letter-spacing: -.035em;
      line-height: 1.15;
    }

    .tool-card.featured h3 { margin-top: 146px; font-size: 40px; }

    .tool-card p {
      max-width: 510px;
      margin: 0;
      color: currentColor;
      font-size: 13px;
      line-height: 1.75;
      opacity: .72;
    }

    .tool-link {
      position: absolute;
      right: 26px;
      bottom: 25px;
      display: grid;
      place-items: center;
      width: 43px;
      height: 43px;
      border: 1px solid currentColor;
      border-radius: 50%;
      transition: transform .2s ease, background .2s ease, color .2s ease;
    }

    .tool-card.live:hover .tool-link {
      color: var(--ink);
      background: var(--yellow);
      transform: rotate(-38deg);
    }

    .tool-link svg { width: 17px; height: 17px; }

    .roadmap {
      display: grid;
      grid-template-columns: 1fr 1fr;
      min-height: 300px;
      margin-bottom: 110px;
      border: 1px solid var(--ink);
      background: var(--yellow);
    }

    .roadmap-copy { padding: clamp(36px, 6vw, 72px); }
    .roadmap-copy h2 { max-width: 650px; font-size: clamp(38px, 4.3vw, 60px); }
    .roadmap-copy p {
      max-width: 520px;
      margin: 24px 0 0;
      font-size: 14px;
      line-height: 1.8;
    }

    .roadmap-list {
      display: grid;
      align-content: center;
      padding: 36px clamp(30px, 5vw, 60px);
      border-left: 1px solid var(--ink);
      background: var(--ink);
      color: white;
    }

    .roadmap-item {
      display: grid;
      grid-template-columns: 34px 1fr auto;
      gap: 16px;
      align-items: center;
      padding: 19px 0;
      border-bottom: 1px solid rgba(255,255,255,.18);
    }

    .roadmap-item:last-child { border-bottom: 0; }
    .roadmap-item small { color: var(--yellow); font: 700 10px/1 var(--sans); letter-spacing: .1em; }
    .roadmap-item b { font-family: var(--serif); font-size: 19px; font-weight: 400; }
    .roadmap-item span { color: rgba(255,255,255,.52); font-size: 11px; }

    footer {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 30px;
      align-items: end;
      padding: 50px 0;
      border-top: 1px solid var(--line);
    }

    .footer-mark {
      --dot-travel: 22px;
      width: min(360px, 80vw);
      overflow: visible;
      cursor: default;
    }
    .footer-copy { text-align: right; color: var(--muted); font-size: 11px; line-height: 1.8; }
    .empty-state { grid-column: 1 / -1; padding: 60px; border: 1px dashed var(--line); text-align: center; color: var(--muted); }

    @keyframes reveal { from { opacity: 0; } to { opacity: 1; } }
    @keyframes rise { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: none; } }
    @keyframes cardIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
    @keyframes spin { to { transform: rotate(360deg); } }
    @keyframes pulse { 50% { opacity: .25; transform: scale(.7); } }
    @keyframes dotOrbitClockwise {
      0%, 100% { transform: translate(0, 0) scale(1); }
      12% { transform: translate(var(--dot-travel), 0) scale(.86); }
      34% { transform: translate(0, var(--dot-travel)) scale(1); }
      56% { transform: translate(calc(var(--dot-travel) * -1), 0) scale(.86); }
      78% { transform: translate(0, calc(var(--dot-travel) * -1)) scale(1); }
      92% { transform: translate(calc(var(--dot-travel) * .45), 0) scale(.92); }
    }
    @keyframes dotOrbitCounter {
      0%, 100% { transform: translate(0, 0) scale(1); }
      12% { transform: translate(calc(var(--dot-travel) * -1), 0) scale(.86); }
      34% { transform: translate(0, calc(var(--dot-travel) * -1)) scale(1); }
      56% { transform: translate(var(--dot-travel), 0) scale(.86); }
      78% { transform: translate(0, var(--dot-travel)) scale(1); }
      92% { transform: translate(calc(var(--dot-travel) * -.45), 0) scale(.92); }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
    }

    @media (max-width: 900px) {
      .hero { grid-template-columns: 1fr; padding-top: 60px; }
      .hero-art { min-height: 330px; }
      .orbit { width: 320px; }
      .tool-card, .tool-card.featured { grid-column: span 6; }
      .tool-card.featured h3 { margin-top: 160px; }
      .roadmap { grid-template-columns: 1fr; }
      .roadmap-list { border-top: 1px solid var(--ink); border-left: 0; }
    }

    @media (max-width: 640px) {
      .shell { width: min(100% - 28px, 520px); }
      .site-header { height: 76px; }
      .wordmark { width: 105px; }
      .brand-label { display: none; }
      .header-nav { gap: 10px; }
      .header-nav > a:not(.nav-cta) { display: none; }
      .nav-cta { padding: 9px 13px; font-size: 12px; }
      .hero { min-height: auto; padding: 52px 0 42px; }
      h1 { font-size: clamp(54px, 19vw, 78px); }
      .hero-intro { grid-template-columns: 42px 1fr; gap: 15px; margin-top: 36px; }
      .hero-intro p { font-size: 14px; }
      .hero-art { min-height: 320px; }
      .stamp { width: 180px; }
      .orbit { width: 260px; }
      .tools-section { padding: 72px 0 78px; }
      .section-head { grid-template-columns: 1fr; align-items: start; margin-bottom: 30px; }
      .tool-filter { width: max-content; max-width: 100%; overflow-x: auto; }
      .filter-btn { white-space: nowrap; padding: 8px 13px; }
      .tool-card, .tool-card.featured { grid-column: 1 / -1; min-height: 310px; }
      .tool-card.featured .tool-icon { width: 92px; height: 92px; }
      .tool-card.featured .tool-icon svg { width: 40px; height: 40px; }
      .tool-card.featured h3 { margin-top: 145px; font-size: 34px; }
      .roadmap { margin-bottom: 72px; }
      .roadmap-copy { padding: 38px 27px; }
      .roadmap-list { padding: 22px 27px; }
      .roadmap-item { grid-template-columns: 26px 1fr; }
      .roadmap-item span { display: none; }
      footer { grid-template-columns: 1fr; }
      .footer-copy { text-align: left; }
    }
  </style>
</head>
<body>
  <div class="noise" aria-hidden="true"></div>

  <header class="site-header shell">
    <a class="brand" href="/" aria-label="OXOX 首页">
      <Wordmark />
      <span class="brand-label">外贸小工具</span>
    </a>
    <nav class="header-nav" aria-label="主导航">
      <a href="#tools">全部工具</a>
      <a href="#roadmap">即将上线</a>
      <a class="nav-cta" href="#tools">
        开始使用
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7">
          <path d="M3 8h10M9 4l4 4-4 4"/>
        </svg>
      </a>
    </nav>
  </header>

  <main>
    <section class="hero shell">
      <div class="hero-copy">
        <p class="eyebrow">Tools for global sellers</p>
        <h1>让外贸工作<br>少一点<span class="accent">重复</span></h1>
        <div class="hero-intro">
          <span class="hero-no">NO.<br>001</span>
          <p><strong>OXOX 外贸小工具</strong>，把图片处理、文本优化和日常计算，做成打开就能用的小工具。无需注册，不绕弯子。</p>
        </div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <div class="orbit"></div>
        <div class="stamp">
          <div class="stamp-inner">
            <div>
              <b>OX<br>OX</b>
              <span>MADE FOR TRADE</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="tools-section shell" id="tools">
      <div class="section-head">
        <div>
          <p class="section-kicker">OXOX Toolbox / 2026</p>
          <h2>今天，要解决什么？</h2>
        </div>
        <div class="tool-filter" role="group" aria-label="工具分类">
          <button class="filter-btn active" type="button" data-filter="all">全部</button>
          <button class="filter-btn" type="button" data-filter="image">图片</button>
          <button class="filter-btn" type="button" data-filter="copy">文案</button>
          <button class="filter-btn" type="button" data-filter="calculate">计算</button>
        </div>
      </div>
      <div class="tools-grid" id="toolGrid"></div>
    </section>

    <section class="roadmap shell" id="roadmap">
      <div class="roadmap-copy">
        <p class="section-kicker">Building in public</p>
        <h2>小工具，会一点一点长出来。</h2>
        <p>先解决每天都碰到的小麻烦，再慢慢扩展。每一个工具都坚持：无需学习、无需安装、打开即用。</p>
      </div>
      <div class="roadmap-list">
        <div class="roadmap-item"><small>01</small><b>商品图尺寸处理</b><span>已上线</span></div>
        <div class="roadmap-item"><small>02</small><b>WebP 转换与重命名</b><span>已上线</span></div>
        <div class="roadmap-item"><small>03</small><b>外贸邮件润色</b><span>规划中</span></div>
        <div class="roadmap-item"><small>04</small><b>FOB 利润计算</b><span>规划中</span></div>
      </div>
    </section>
  </main>

  <footer class="shell">
    <Wordmark class="footer-mark" />
    <div class="footer-copy">
      <div>OXOX.CN · 外贸人的轻量工具箱</div>
      <div>© <span id="year"></span> OXOX. MADE WITH CARE.</div>
    </div>
  </footer>

  <script is:inline define:vars={{ tools }}>
    // @ts-nocheck
    const icons = {
      image: '<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="5" y="5" width="22" height="22" rx="2"/><circle cx="12" cy="12" r="2.5"/><path d="m7 24 7-7 4 4 3-3 5 5"/></svg>',
      mail: '<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="4" y="7" width="24" height="18" rx="2"/><path d="m5 9 11 9L27 9"/></svg>',
      calculate: '<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="7" y="4" width="18" height="24" rx="2"/><path d="M11 9h10M11 15h2m5 0h2m-9 5h2m5 0h2m-9 5h2m5 0h2"/></svg>',
      convert: '<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M6 11h17l-4-4m7 14H9l4 4"/></svg>',
      text: '<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M6 8h20M10 8v18m12-18v18M7 26h6m6 0h6"/></svg>'
    };

    const arrowIcon = '<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 16 16 4M7 4h9v9"/></svg>';
    const grid = document.querySelector("#toolGrid");
    const filterButtons = document.querySelectorAll(".filter-btn");

    function renderTools(filter = "all") {
      const visible = tools.filter(tool => filter === "all" || tool.category === filter);

      if (!visible.length) {
        grid.innerHTML = '<div class="empty-state">这个分类的工具正在路上。</div>';
        return;
      }

      grid.innerHTML = visible.map((tool, index) => {
        const number = String(tools.indexOf(tool) + 1).padStart(2, "0");
        const live = tool.status === "live";
        const tag = live ? "a" : "article";
        const attrs = live
          ? `href="${tool.url}" target="_blank" rel="noopener noreferrer" aria-label="打开${tool.title}"`
          : "";

        return `
          <${tag} class="tool-card ${live ? "live" : "planned"} ${tool.featured ? "featured" : ""}" ${attrs} style="animation-delay:${index * 60}ms">
            <div class="card-top">
              <span class="tool-index">TOOL / ${number}</span>
              <span class="tool-status">${live ? "立即使用" : "即将上线"}</span>
            </div>
            <div class="tool-icon" aria-hidden="true">${icons[tool.icon]}</div>
            <h3>${tool.title}</h3>
            <p>${tool.description}</p>
            ${live ? `<span class="tool-link" aria-hidden="true">${arrowIcon}</span>` : ""}
          </${tag}>
        `;
      }).join("");
    }

    filterButtons.forEach(button => {
      button.addEventListener("click", () => {
        filterButtons.forEach(item => item.classList.remove("active"));
        button.classList.add("active");
        renderTools(button.dataset.filter);
      });
    });

    document.querySelector("#year").textContent = new Date().getFullYear();
    renderTools();
  </script>
</body>
</html>
