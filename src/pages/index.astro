            <input id="companyQuery" name="q" type="search" placeholder="例如：浙江正泰或 zhengtai" autocomplete="off" role="combobox" aria-autocomplete="list" aria-controls="companySuggestions" aria-expanded="false" required>
            <ul class="company-suggestions" id="companySuggestions" role="listbox" aria-label="最新周期企业联想" hidden></ul>
          </div>
          <button type="submit">查询企业</button>
        </form>
        <a class="full-ranking-cta" href="/yueqing-export-ranking/">
          <span>
            <small>FULL RANKING / 完整榜单</small>
            <strong>查看全部 {formatNumber(latestRanking.records.length)} 家企业完整排名</strong>
          </span>
          <span aria-hidden="true">→</span>
        </a>
        <p class="search-hint">支持企业名称、拼音或企业编号，例如 zhengtai、ZJZTDQ 或 YQ000001</p>
      </div>

      <div class="hero-art" aria-label="最新排名周期数据">
        <p class="sr-only">{formatNumber(latestRanking.records.length)} 条排名记录，{latestRanking.bands.length} 个出口额区间，已收录 {periods.periods.length} 个周期。</p>
        <div class="orbit" aria-hidden="true"></div>
        <article class="period-card">
          <small>LATEST PERIOD / 最新周期</small>
          <strong>{latestRanking.period.label}</strong>
          <div class="period-stat"><span>排名记录</span><b>{formatNumber(latestRanking.records.length)}</b></div>
          <div class="period-stat"><span>出口额区间</span><b>{latestRanking.bands.length}</b></div>
          <div class="period-stat"><span>累计周期</span><b>{periods.periods.length}</b></div>
          <a class="period-link" href="/yueqing-export-ranking/"><span>查看 {latestRanking.period.label}完整排名</span><span aria-hidden="true">→</span></a>
        </article>
      </div>
    </section>

    <section class="data-strip shell" aria-label="最新数据摘要">
      <div class="data-label"><i aria-hidden="true"></i> CONFIRMED DATA</div>
      <div class="data-value"><span>最新周期</span><b>{latestRanking.period.label}</b></div>
      <div class="data-value"><span>排名记录</span><b>{formatNumber(latestRanking.records.length)}</b></div>
      <div class="data-value"><span>出口额区间</span><b>{latestRanking.bands.length}</b></div>
      <a class="data-strip-link" href="/yueqing-export-ranking/"><span>进入数据库</span><span aria-hidden="true">↗</span></a>
    </section>

    <section class="section shell">
      <div class="section-head">
        <div>
          <p class="section-kicker">LATEST RANKING / 最新排名</p>
          <h2>本期排名前列企业</h2>
        </div>
        <a class="text-link" href="/yueqing-export-ranking/">查看 {formatNumber(latestRanking.records.length)} 条排名记录 <span aria-hidden="true">→</span></a>
      </div>

      <div class="ranking-preview">
        <div class="ranking-list">
          <div class="ranking-head" aria-hidden="true">
            <span>排名</span><span>企业名称</span><span>累计出口额区间</span><span></span>
          </div>
          {topRecords.map((record) => (
            <a class="ranking-row" href={`/yueqing-export-ranking/?q=${encodeURIComponent(record.company_name)}`}>
              <b>{String(record.rank).padStart(2, "0")}</b>
              <span class="ranking-company">{record.company_name}<small>{record.company_id}</small></span>
