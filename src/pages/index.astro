      12% { transform: translate(calc(var(--dot-travel) * -1), 0) scale(.86); }
      34% { transform: translate(0, calc(var(--dot-travel) * -1)) scale(1); }
      56% { transform: translate(var(--dot-travel), 0) scale(.86); }
      78% { transform: translate(0, var(--dot-travel)) scale(1); }
      92% { transform: translate(calc(var(--dot-travel) * -.45), 0) scale(.92); }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
