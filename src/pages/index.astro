---
import Wordmark from "../components/Wordmark.astro";
import tools from "../data/tools.js";
import periods from "../../public/data/yueqing-export-ranking/periods.json";
import latestRanking from "../../public/data/yueqing-export-ranking/2026-ytd-06.json";

const topRecords = latestRanking.records.slice(0, 3);
const liveTools = tools.filter((tool) => tool.status === "live" && tool.category !== "data");
const formatNumber = (value: number) => new Intl.NumberFormat("zh-CN").format(value);
const capabilities = [
  ["01", "累计周期切换", "在已收录的累计周期之间切换，查看企业当期排名和出口额区间。"],
  ["02", "企业跨期档案", "使用稳定企业编号连接同一主体，集中查看历次排名记录。"],
  ["03", "排名变化对比", "比较较上期和去年同期名次，快速识别企业排名变化。"],
];
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="查询乐清企业累计出口排名、出口额区间和历史名次变化，覆盖多个累计周期。">
  <meta name="theme-color" content="#f2f0e8">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='16' fill='%2318201d'/%3E%3Ccircle cx='32' cy='32' r='18' fill='none' stroke='%23f5d451' stroke-width='7'/%3E%3Ccircle cx='32' cy='32' r='5' fill='%23ff5c35'/%3E%3C/svg%3E">
  <title>乐清出口企业排名查询｜乐清外贸出口数据｜OXOX</title>
  <style is:global>
    :root {
      --paper: #f2f0e8;
      --paper-light: #faf9f4;
      --ink: #18201d;
      --muted: #68716c;
      --green: #0b634b;
      --green-dark: #064636;
      --orange: #ff5c35;
      --yellow: #f5d451;
      --line: rgba(24, 32, 29, .16);
      --shadow: 0 24px 70px rgba(24, 32, 29, .1);
      --serif: "Iowan Old Style", "Baskerville", "Songti SC", "STSong", serif;
      --sans: "Avenir Next", "PingFang SC", "Hiragino Sans GB", sans-serif;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; background: var(--paper); }
    body {
      margin: 0;
      min-width: 320px;
      color: var(--ink);
      font-family: var(--sans);
      background:
        linear-gradient(90deg, transparent 49.9%, rgba(24,32,29,.035) 50%, transparent 50.1%),
        radial-gradient(circle at 12% 0%, rgba(255,255,255,.96), transparent 31rem),
        var(--paper);
      background-size: 56px 100%, auto, auto;
    }

    a { color: inherit; text-decoration: none; }
    button, input { color: inherit; font: inherit; }
    button { cursor: pointer; }
    svg { display: block; }

    .noise {
      position: fixed;
      inset: 0;
      z-index: 20;
      opacity: .03;
      pointer-events: none;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.8'/%3E%3C/svg%3E");
    }

    .shell {
      width: min(1240px, calc(100% - 48px));
      margin: 0 auto;
    }

    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .site-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 92px;
      border-bottom: 1px solid var(--line);
      animation: reveal .7s ease both;
    }

    .brand {
      display: inline-flex;
      align-items: center;
      gap: 14px;
    }

    .wordmark {
      --dot-travel: 10px;
      width: 126px;
      height: auto;
      overflow: visible;
    }

    .wordmark .logo-dot,
    .footer-mark .logo-dot {
      transform-box: fill-box;
      transform-origin: center;
      will-change: transform;
    }

    .brand:hover .dot-warm,
    .brand:focus-visible .dot-warm,
    .footer-mark:hover .dot-warm {
      animation: dotOrbitClockwise .9s cubic-bezier(.45, 0, .2, 1);
    }

    .brand:hover .dot-green,
    .brand:focus-visible .dot-green,
    .footer-mark:hover .dot-green {
      animation: dotOrbitCounter .9s .06s cubic-bezier(.45, 0, .2, 1);
    }

    .brand-label {
      padding-left: 14px;
      border-left: 1px solid var(--line);
      color: var(--muted);
      font-size: 12px;
      font-weight: 650;
      letter-spacing: .12em;
    }

    .header-nav {
      display: flex;
      align-items: center;
      gap: 32px;
      font-size: 13px;
      font-weight: 650;
    }

    .header-nav > a:not(.nav-cta) {
      position: relative;
      padding: 9px 0;
    }

    .header-nav > a:not(.nav-cta)::after {
      content: "";
      position: absolute;
      right: 0;
      bottom: 3px;
      left: 0;
      height: 2px;
      background: var(--orange);
      transform: scaleX(0);
      transform-origin: right;
      transition: transform .24s ease;
    }

    .header-nav > a:hover::after,
    .header-nav > a:focus-visible::after {
      transform: scaleX(1);
      transform-origin: left;
    }

    .nav-cta {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 11px 16px;
      border: 1px solid var(--ink);
      border-radius: 100px;
      background: var(--paper-light);
      transition: transform .2s ease, box-shadow .2s ease;
    }

    .nav-cta:hover,
    .nav-cta:focus-visible {
      transform: translateY(-2px);
      box-shadow: 4px 4px 0 var(--yellow);
    }

    .hero {
      position: relative;
      display: grid;
      grid-template-columns: minmax(0, 1.25fr) minmax(300px, .75fr);
      gap: clamp(42px, 6vw, 82px);
      min-height: 650px;
      padding: 76px 0 68px;
      border-bottom: 1px solid var(--line);
    }

    .hero-copy {
      position: relative;
      z-index: 5;
      align-self: center;
    }

    .eyebrow {
      display: flex;
      align-items: center;
      gap: 12px;
      margin: 0 0 28px;
      color: var(--green);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: .18em;
      text-transform: uppercase;
      animation: rise .7s .12s ease both;
    }

    .eyebrow::before {
      content: "";
      width: 28px;
      height: 7px;
      border-radius: 100px;
      background: var(--orange);
    }

    h1 {
      max-width: 830px;
      margin: 0;
      font-family: var(--serif);
      font-size: clamp(58px, 7.2vw, 104px);
      font-weight: 400;
      letter-spacing: -.07em;
      line-height: .9;
      animation: rise .8s .18s ease both;
    }

    h1 .accent {
      position: relative;
      display: inline-block;
      color: var(--green);
      font-style: italic;
    }

    h1 .accent::after {
      content: "";
      position: absolute;
      right: -.08em;
      bottom: -.09em;
      left: .04em;
      height: .085em;
      border-radius: 50%;
      background: var(--orange);
      transform: rotate(-2deg);
    }

    .hero-intro {
      max-width: 640px;
      margin: 32px 0 0;
      color: var(--muted);
      font-size: 15px;
      line-height: 1.85;
      animation: rise .8s .26s ease both;
    }

    .hero-intro strong { color: var(--ink); }

    .company-search {
      position: relative;
      display: grid;
      grid-template-columns: 1fr auto;
      max-width: 760px;
      margin-top: 34px;
      border: 2px solid var(--green);
      background: white;
      box-shadow: 8px 8px 0 rgba(245, 212, 81, .95);
      animation: rise .8s .34s ease both;
      transition: box-shadow .2s ease, transform .2s ease;
    }

    .company-search:focus-within {
      box-shadow: 11px 11px 0 var(--yellow);
      transform: translate(-2px, -2px);
    }

    .search-icon {
      position: absolute;
      top: 50%;
      left: 21px;
      width: 23px;
      transform: translateY(-50%);
      pointer-events: none;
    }

    .company-search input {
      width: 100%;
      min-width: 0;
      min-height: 72px;
      padding: 0 24px 0 58px;
      border: 0;
      outline: 0;
      background: transparent;
      font-size: 15px;
    }

    .company-search input::placeholder { color: #8a918d; }

    .company-search button {
      min-width: 142px;
      padding: 0 27px;
      border: 0;
      color: white;
      background: var(--orange);
      font-weight: 800;
      transition: color .2s ease, background .2s ease;
    }

    .company-search button:hover,
    .company-search button:focus-visible {
      color: var(--yellow);
      background: var(--green);
    }

    .search-hint {
      display: flex;
      align-items: center;
      gap: 9px;
      margin: 17px 0 0;
      color: var(--muted);
      font-size: 11px;
      animation: rise .8s .4s ease both;
    }

    .search-hint::before {
      content: "";
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--green);
      box-shadow: 0 0 0 4px rgba(11, 99, 75, .1);
    }

    .hero-art {
      position: relative;
      z-index: 3;
      display: grid;
      place-items: center;
      min-height: 480px;
      animation: rise .9s .3s ease both;
    }

    .orbit {
      position: absolute;
      width: min(31vw, 390px);
      aspect-ratio: 1;
      border: 1px solid var(--line);
      border-radius: 50%;
      animation: spin 30s linear infinite;
    }

    .orbit::before,
    .orbit::after {
      content: "";
      position: absolute;
      z-index: 4;
      border-radius: 50%;
    }

    .orbit::before {
      top: 8%;
      left: 7%;
      width: 18px;
      height: 18px;
      background: var(--orange);
      box-shadow: 0 0 0 8px var(--paper);
    }

    .orbit::after {
      right: 3%;
      bottom: 17%;
      width: 14px;
      height: 14px;
      background: var(--green);
      box-shadow: 0 0 0 8px var(--paper);
    }

    .period-card {
      position: relative;
      z-index: 5;
      width: min(100%, 350px);
      padding: 30px;
      border: 1px solid var(--ink);
      background: var(--yellow);
      box-shadow: 12px 12px 0 var(--green);
      transform: rotate(1.5deg);
      transition: transform .35s cubic-bezier(.2,.8,.2,1);
    }

    .period-card:hover { transform: rotate(-1deg) translateY(-4px); }

    .period-card > small {
      display: block;
      margin-bottom: 25px;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: .18em;
    }

    .period-card strong {
      display: block;
      padding-bottom: 22px;
      border-bottom: 1px solid rgba(24,32,29,.28);
      font-family: var(--serif);
      font-size: clamp(36px, 3.3vw, 46px);
      font-weight: 400;
      letter-spacing: -.05em;
      line-height: 1;
      white-space: nowrap;
    }

    .period-stat {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 15px;
      align-items: center;
      padding: 16px 0;
      border-bottom: 1px solid rgba(24,32,29,.18);
      font-size: 12px;
    }

    .period-stat:last-of-type { border-bottom: 0; }

    .period-stat b {
      font-family: var(--serif);
      font-size: 23px;
      font-weight: 400;
    }

    .period-link {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 15px;
      padding: 14px 16px;
      color: white;
      background: var(--ink);
      font-size: 12px;
      font-weight: 750;
      transition: color .2s ease, background .2s ease;
    }

    .period-link:hover,
    .period-link:focus-visible {
      color: var(--yellow);
      background: var(--green);
    }

    .data-strip {
      display: grid;
      grid-template-columns: auto repeat(3, 1fr) auto;
      border-bottom: 1px solid var(--line);
    }

    .data-strip > * {
      display: flex;
      align-items: center;
      min-height: 72px;
      padding: 0 23px;
      border-left: 1px solid var(--line);
    }

    .data-strip > *:last-child { border-right: 1px solid var(--line); }

    .data-label {
      gap: 10px;
      color: var(--green);
      font-size: 10px;
      font-weight: 850;
      letter-spacing: .12em;
    }

    .data-label i {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: var(--orange);
    }

    .data-value {
      justify-content: space-between;
      gap: 14px;
      color: var(--muted);
      font-size: 11px;
    }

    .data-value b {
      color: var(--ink);
      font-family: var(--serif);
      font-size: 22px;
      font-weight: 400;
      white-space: nowrap;
    }

    .data-strip-link {
      gap: 8px;
      color: var(--green);
      font-size: 11px;
      font-weight: 800;
      white-space: nowrap;
    }

    .section {
      padding: 94px 0 105px;
      border-bottom: 1px solid var(--line);
    }

    .section-head {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 35px;
      margin-bottom: 40px;
    }

    .section-kicker {
      margin: 0 0 11px;
      color: var(--orange);
      font-size: 10px;
      font-weight: 850;
      letter-spacing: .18em;
      text-transform: uppercase;
    }

    h2 {
      margin: 0;
      font-family: var(--serif);
      font-size: clamp(42px, 5vw, 67px);
      font-weight: 400;
      letter-spacing: -.055em;
      line-height: 1;
    }

    .text-link {
      display: inline-flex;
      align-items: center;
      gap: 11px;
      padding-bottom: 4px;
      border-bottom: 1px solid currentColor;
      color: var(--green);
      font-size: 12px;
      font-weight: 800;
    }

    .text-link span { transition: transform .2s ease; }
    .text-link:hover span { transform: translateX(4px); }

    .ranking-preview {
      display: grid;
      grid-template-columns: minmax(0, 1.45fr) minmax(260px, .55fr);
      border: 1px solid var(--ink);
      background: var(--paper-light);
    }

    .ranking-list { min-width: 0; }

    .ranking-head,
    .ranking-row {
      display: grid;
      grid-template-columns: 84px minmax(240px, 1fr) 205px 42px;
      align-items: center;
    }

    .ranking-head {
      min-height: 52px;
      color: rgba(255,255,255,.64);
      background: var(--ink);
      font-size: 9px;
      font-weight: 750;
      letter-spacing: .12em;
    }

    .ranking-head span,
    .ranking-row > * { padding: 0 20px; }

    .ranking-row {
      min-height: 96px;
      border-bottom: 1px solid var(--line);
      transition: color .18s ease, background .18s ease;
    }

    .ranking-row:last-child { border-bottom: 0; }

    .ranking-row:hover,
    .ranking-row:focus-visible {
      color: white;
      background: var(--green);
      outline: 0;
    }

    .ranking-row > b {
      font-family: var(--serif);
      font-size: 33px;
      font-weight: 400;
    }

    .ranking-company {
      min-width: 0;
      font-size: 14px;
      font-weight: 750;
    }

    .ranking-company small {
      display: block;
      margin-top: 7px;
      font-size: 9px;
      font-weight: 600;
      letter-spacing: .11em;
      opacity: .55;
    }

    .ranking-row em {
      justify-self: start;
      padding: 7px 10px;
      border: 1px solid currentColor;
      border-radius: 100px;
      font-size: 10px;
      font-style: normal;
      font-weight: 750;
      white-space: nowrap;
    }

    .ranking-arrow {
      display: grid;
      place-items: center;
      width: 35px;
      height: 35px;
      padding: 0 !important;
      border: 1px solid currentColor;
      border-radius: 50%;
    }

    .ranking-note {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 34px;
      border-left: 1px solid var(--ink);
      color: white;
      background: var(--green);
    }

    .ranking-note small {
      font-size: 9px;
      font-weight: 800;
      letter-spacing: .16em;
      opacity: .62;
    }

    .ranking-note strong {
      display: block;
      margin: 28px 0 18px;
      font-family: var(--serif);
      font-size: 31px;
      font-weight: 400;
      letter-spacing: -.04em;
      line-height: 1.15;
    }

    .ranking-note p {
      margin: 0;
      color: rgba(255,255,255,.68);
      font-size: 12px;
      line-height: 1.8;
    }

    .ranking-note .note-mark {
      align-self: end;
      width: 82px;
      height: 82px;
      margin-top: 40px;
      border: 1px solid rgba(255,255,255,.5);
      border-radius: 50%;
      background:
        radial-gradient(circle, var(--orange) 0 8px, transparent 9px),
        radial-gradient(circle, transparent 0 25px, var(--yellow) 26px 29px, transparent 30px);
    }

    .capabilities {
      padding: 94px 0;
      color: white;
      background: var(--ink);
    }

    .capabilities .section-kicker { color: var(--yellow); }
    .capabilities h2 { max-width: 780px; }

    .capability-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      margin-top: 52px;
      border-top: 1px solid rgba(255,255,255,.2);
      border-left: 1px solid rgba(255,255,255,.2);
    }

    .capability-card {
      min-height: 270px;
      padding: 28px;
      border-right: 1px solid rgba(255,255,255,.2);
      border-bottom: 1px solid rgba(255,255,255,.2);
    }

    .capability-card small {
      color: var(--orange);
      font: 800 10px/1 var(--sans);
      letter-spacing: .13em;
    }

    .capability-card h3 {
      margin: 78px 0 15px;
      font-family: var(--serif);
      font-size: 27px;
      font-weight: 400;
      letter-spacing: -.035em;
    }

    .capability-card p {
      max-width: 310px;
      margin: 0;
      color: rgba(255,255,255,.58);
      font-size: 12px;
      line-height: 1.75;
    }

    .tools-section { padding: 94px 0 108px; }

    .compact-tools {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 18px;
      margin-top: 42px;
    }

    .compact-tool {
      position: relative;
      min-height: 240px;
      padding: 28px;
      border: 1px solid var(--line);
      background: rgba(250,249,244,.72);
      overflow: hidden;
      transition: color .25s ease, background .25s ease, transform .25s ease, box-shadow .25s ease;
    }

    .compact-tool:hover,
    .compact-tool:focus-visible {
      color: white;
      background: var(--green);
      box-shadow: var(--shadow);
      transform: translateY(-5px);
      outline: 0;
    }

    .compact-tool small {
      font-size: 9px;
      font-weight: 800;
      letter-spacing: .15em;
      opacity: .58;
    }

    .compact-tool h3 {
      margin: 57px 0 13px;
      font-family: var(--serif);
      font-size: 30px;
      font-weight: 400;
      letter-spacing: -.04em;
    }

    .compact-tool p {
      max-width: 480px;
      margin: 0;
      font-size: 12px;
      line-height: 1.75;
      opacity: .66;
    }

    .compact-tool > span {
      position: absolute;
      top: 26px;
      right: 27px;
      display: grid;
      place-items: center;
      width: 42px;
      height: 42px;
      border: 1px solid currentColor;
      border-radius: 50%;
      font-size: 18px;
      transition: color .2s ease, background .2s ease, transform .2s ease;
    }

    .compact-tool:hover > span {
      color: var(--ink);
      background: var(--yellow);
      transform: rotate(-35deg);
    }

    footer {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 30px;
      align-items: end;
      padding: 52px 0;
      border-top: 1px solid var(--line);
    }

    .footer-mark {
      --dot-travel: 22px;
      width: min(360px, 80vw);
      overflow: visible;
      cursor: default;
    }

    .footer-copy {
      max-width: 300px;
      color: var(--muted);
      text-align: right;
      font-size: 11px;
      line-height: 1.8;
    }

    @keyframes reveal { from { opacity: 0; } to { opacity: 1; } }
    @keyframes rise { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: none; } }
    @keyframes spin { to { transform: rotate(360deg); } }
    @keyframes dotOrbitClockwise {
      0%, 100% { transform: translate(0, 0) scale(1); }
      12% { transform: translate(var(--dot-travel), 0) scale(.86); }
      34% { transform: translate(0, var(--dot-travel)) scale(1); }
      56% { transform: translate(calc(var(--dot-travel) * -1), 0) scale(.86); }
      78% { transform: translate(0, calc(var(--dot-travel) * -1)) scale(1); }
      92% { transform: translate(calc(var(--dot-travel) * .45), 0) scale(.92); }
    }
    @keyframes dotOrbitCounter {
      0%, 100% { transform: translate(0, 0) scale(1); }
      12% { transform: translate(calc(var(--dot-travel) * -1), 0) scale(.86); }
      34% { transform: translate(0, calc(var(--dot-travel) * -1)) scale(1); }
      56% { transform: translate(var(--dot-travel), 0) scale(.86); }
      78% { transform: translate(0, var(--dot-travel)) scale(1); }
      92% { transform: translate(calc(var(--dot-travel) * -.45), 0) scale(.92); }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        scroll-behavior: auto !important;
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: .01ms !important;
      }
    }

    @media (max-width: 960px) {
      .hero { grid-template-columns: 1fr; min-height: 0; }
      .hero-art { min-height: 390px; }
      .orbit { width: 350px; }
      .data-strip { grid-template-columns: 1fr 1fr; }
      .data-strip > * { border-bottom: 1px solid var(--line); }
      .data-label { grid-column: 1 / -1; }
      .data-strip-link { grid-column: 1 / -1; justify-content: center; }
      .ranking-preview { grid-template-columns: 1fr; }
      .ranking-note { border-top: 1px solid var(--ink); border-left: 0; }
    }

    @media (max-width: 760px) {
      .shell { width: min(100% - 28px, 560px); }
      .site-header { height: 76px; }
      .wordmark { width: 105px; }
      .brand-label { display: none; }
      .header-nav { gap: 9px; }
      .header-nav > a:not(.nav-cta) { display: none; }
      .nav-cta { padding: 9px 13px; font-size: 12px; }
      .hero { gap: 28px; padding: 52px 0 46px; }
      .hero-copy { align-self: start; }
      h1 { font-size: clamp(50px, 15.5vw, 74px); }
      .hero-intro { margin-top: 27px; font-size: 13px; }
      .company-search { grid-template-columns: 1fr; margin-top: 27px; }
      .search-icon { top: 31px; }
      .company-search input { min-height: 62px; padding-right: 16px; font-size: 13px; }
      .company-search button { min-height: 53px; }
      .hero-art { min-height: 350px; }
      .orbit { width: min(86vw, 330px); }
      .period-card { width: min(90%, 340px); padding: 25px; }
      .data-strip { grid-template-columns: 1fr; }
      .data-label, .data-strip-link { grid-column: auto; }
      .data-strip > * { border-right: 1px solid var(--line); }
      .section, .tools-section { padding: 68px 0 76px; }
      .section-head { align-items: start; flex-direction: column; margin-bottom: 30px; }
      .ranking-head { display: none; }
      .ranking-row {
        grid-template-columns: 52px 1fr 38px;
        min-height: 108px;
      }
      .ranking-row > * { padding: 0 12px; }
      .ranking-row > b { font-size: 27px; }
      .ranking-company { font-size: 13px; }
      .ranking-row em {
        grid-column: 2;
        margin-top: -24px;
        font-size: 9px;
      }
      .ranking-arrow { grid-column: 3; grid-row: 1 / 3; }
      .ranking-note { padding: 28px; }
      .capabilities { padding: 68px 0; }
      .capability-grid { grid-template-columns: 1fr; margin-top: 36px; }
      .capability-card { min-height: 220px; }
      .capability-card h3 { margin-top: 54px; }
      .compact-tools { grid-template-columns: 1fr; }
      footer { grid-template-columns: 1fr; }
      .footer-copy { text-align: left; }
    }
  </style>
</head>
<body>
  <div class="noise" aria-hidden="true"></div>

  <header class="site-header shell">
    <a class="brand" href="/" aria-label="OXOX 乐清出口数据首页">
      <Wordmark />
      <span class="brand-label">乐清出口数据</span>
    </a>
    <nav class="header-nav" aria-label="主要导航">
      <a href="/yueqing-export-ranking/">出口排名</a>
      <a href="#data-capabilities">数据说明</a>
      <a class="nav-cta" href="#auxiliary-tools">辅助工具 <span aria-hidden="true">↓</span></a>
    </nav>
  </header>

  <main>
    <section class="hero shell">
      <div class="hero-copy">
        <p class="eyebrow">YUEQING EXPORT DATA / 乐清出口数据</p>
        <h1>查询乐清企业<br><span class="accent">出口排名</span></h1>
        <p class="hero-intro"><strong>查询累计出口排名、出口额区间及历史名次变化。</strong> 数据按累计周期整理，不推算未经来源确认的精确出口额。</p>
        <form class="company-search" action="/yueqing-export-ranking/" method="get">
          <label class="sr-only" for="companyQuery">输入企业名称、拼音或企业编号</label>
          <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/></svg>
          <input id="companyQuery" name="q" type="search" placeholder="例如：浙江正泰或 zhengtai" autocomplete="off" required>
          <button type="submit">查询企业</button>
        </form>
        <p class="search-hint">支持企业名称、拼音或企业编号，例如 zhengtai、ZJZTDQ 或 YQ000001</p>
      </div>

      <div class="hero-art" aria-label="最新排名周期数据">
        <p class="sr-only">{formatNumber(latestRanking.records.length)} 条排名记录，{latestRanking.bands.length} 个出口额区间，已收录 {periods.periods.length} 个周期。</p>
        <div class="orbit" aria-hidden="true"></div>
        <article class="period-card">
          <small>LATEST PERIOD / 最新周期</small>
          <strong>{latestRanking.period.label}</strong>
          <div class="period-stat"><span>排名记录</span><b>{formatNumber(latestRanking.records.length)}</b></div>
          <div class="period-stat"><span>出口额区间</span><b>{latestRanking.bands.length}</b></div>
          <div class="period-stat"><span>累计周期</span><b>{periods.periods.length}</b></div>
          <a class="period-link" href="/yueqing-export-ranking/"><span>查看完整排名</span><span aria-hidden="true">→</span></a>
        </article>
      </div>
    </section>

    <section class="data-strip shell" aria-label="最新数据摘要">
      <div class="data-label"><i aria-hidden="true"></i> CONFIRMED DATA</div>
      <div class="data-value"><span>最新周期</span><b>{latestRanking.period.label}</b></div>
      <div class="data-value"><span>排名记录</span><b>{formatNumber(latestRanking.records.length)}</b></div>
      <div class="data-value"><span>出口额区间</span><b>{latestRanking.bands.length}</b></div>
      <a class="data-strip-link" href="/yueqing-export-ranking/"><span>进入数据库</span><span aria-hidden="true">↗</span></a>
    </section>

    <section class="section shell">
      <div class="section-head">
        <div>
          <p class="section-kicker">LATEST RANKING / 最新排名</p>
          <h2>本期排名前列企业</h2>
        </div>
        <a class="text-link" href="/yueqing-export-ranking/">查看 3,180 条排名记录 <span aria-hidden="true">→</span></a>
      </div>

      <div class="ranking-preview">
        <div class="ranking-list">
          <div class="ranking-head" aria-hidden="true">
            <span>排名</span><span>企业名称</span><span>累计出口额区间</span><span></span>
          </div>
          {topRecords.map((record) => (
            <a class="ranking-row" href={`/yueqing-export-ranking/?q=${encodeURIComponent(record.company_name)}`}>
              <b>{String(record.rank).padStart(2, "0")}</b>
              <span class="ranking-company">{record.company_name}<small>{record.company_id}</small></span>
              <em>{record.band_label}</em>
              <span class="ranking-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
        <aside class="ranking-note">
          <div>
            <small>ABOUT THE DATA / 数据说明</small>
            <strong>只展示有来源依据的排名与金额区间</strong>
            <p>当前数据为累计出口排名，不是单月排名。页面不会估算或展示虚构的精确出口金额。</p>
          </div>
          <div class="note-mark" aria-hidden="true"></div>
        </aside>
      </div>
    </section>

    <section class="capabilities" id="data-capabilities">
      <div class="shell">
        <p class="section-kicker">DATA CAPABILITIES / 数据能力</p>
        <h2>从一次查询，到持续观察企业出口位置</h2>
        <div class="capability-grid">
          {capabilities.map(([index, title, description]) => (
            <article class="capability-card">
              <small>{index}</small>
              <h3>{title}</h3>
              <p>{description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="tools-section shell" id="auxiliary-tools">
      <div class="section-head">
        <div>
          <p class="section-kicker">AUXILIARY TOOLS / 辅助工具</p>
          <h2>处理外贸日常里的重复工作</h2>
        </div>
        <a class="text-link" href="/yueqing-export-ranking/">返回出口数据 <span aria-hidden="true">↑</span></a>
      </div>
      <div class="compact-tools">
        {liveTools.map((tool, index) => (
          <a class="compact-tool" href={tool.url}>
            <small>TOOL / {String(index + 1).padStart(2, "0")}</small>
            <h3>{tool.title}</h3>
            <p>{tool.description}</p>
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>
  </main>

  <footer class="shell">
    <Wordmark class="footer-mark" />
    <div class="footer-copy">
      <strong>OXOX.CN · 乐清出口数据</strong><br>
      累计出口排名、出口额区间与历史名次变化。<br>
      数据持续整理，工具作为辅助。
    </div>
  </footer>
</body>
</html>
